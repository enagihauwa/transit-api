    {
      "name": "Stops",
      "description": "Collection of stops with a random getter.",
      "item": [
        {
          "name": "List Stops",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/stops?limit={{default_limit}}&sort=name&order=asc",
              "host": ["{{api_url}}"],
              "path": ["stops"],
              "query": [
                { "key": "limit", "value": "{{default_limit}}" },
                { "key": "sort", "value": "name" },
                { "key": "order", "value": "asc" }
              ]
            },
            "description": "Paginated stop list. Supports sort/order, offset/cursor and filters (city, stopType, zone, name)."
          },
          "response": []
        },
        {
          "name": "List Stops (filtered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/stops?city={{stop_city}}&stopType={{stop_type}}&limit={{default_limit}}",
              "host": ["{{api_url}}"],
              "path": ["stops"],
              "query": [
                { "key": "city", "value": "{{stop_city}}" },
                { "key": "stopType", "value": "{{stop_type}}" },
                { "key": "limit", "value": "{{default_limit}}" }
              ]
            },
            "description": "Filter by city and stop type using environment variables {{stop_city}} and {{stop_type}}."
          },
          "response": []
        },
        {
          "name": "Create Stop",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);",
                  "pm.environment.set('stop_name', 'Transit Hub ' + token.toUpperCase());",
                  "console.log('stop_name = ' + pm.environment.get('stop_name') + ' (editable via env or by disabling this pre-request script)');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('stop_id', json.data.id);",
                  "pm.test('Has id', () => pm.expect(json.data.id).to.match(/^stp_/));",
                  "console.log('Created stop ' + json.data.name + ' id=' + json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{stop_name}}\",\n  \"city\": \"{{stop_city}}\",\n  \"latitude\": {{stop_latitude}},\n  \"longitude\": {{stop_longitude}},\n  \"stop_type\": \"{{stop_type}}\",\n  \"zone\": \"{{stop_zone}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_url}}/stops",
              "host": ["{{api_url}}"],
              "path": ["stops"]
            },
            "description": "Creates a stop. The pre-request script generates a unique {{stop_name}} so repeated runs succeed; override it (or disable the script) to send your own. After-response stores the new {{stop_id}}."
          },
          "response": []
        },
        {
          "name": "Get Stop by ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resp = await pm.sendRequest({",
                  "  url: pm.environment.get('api_url') + '/stops?limit=50',",
                  "  method: 'GET',",
                  "  header: { accept: 'application/json' }",
                  "});",
                  "const stops = resp.json().data || [];",
                  "if (stops.length === 0) throw new Error('No stops found - is the DB seeded?');",
                  "const stop = stops[Math.floor(Math.random() * stops.length)];",
                  "pm.environment.set('stop_id', stop.id);",
                  "console.log('stop_id = ' + stop.id);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Stop has name', () => pm.expect(json.data.name).to.be.a('string'));",
                  "console.log('Stop: ' + json.data.name + ' (' + json.data.city + ')');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/stops/{{stop_id}}",
              "host": ["{{api_url}}"],
              "path": ["stops", "{{stop_id}}"]
            },
            "description": "Pre-request script picks a random existing stop and stores its id as {{stop_id}}."
          },
          "response": []
        },
        {
          "name": "Stops - page 1 (stores cursor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const next = json.meta ? json.meta.nextCursor : null;",
                  "pm.environment.set('cursor', next || '');",
                  "console.log(next ? 'nextCursor stored (' + next.length + ' chars)' : 'Reached last page - cursor cleared');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/stops?limit=5",
              "host": ["{{api_url}}"],
              "path": ["stops"],
              "query": [{ "key": "limit", "value": "5" }]
            },
            "description": "First page. The test script stores meta.nextCursor into {{cursor}} so the next-request works."
          },
          "response": []
        },
        {
          "name": "Stops - next page (uses cursor)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cursor = pm.environment.get('cursor');",
                  "if (!cursor) throw new Error('No cursor stored yet. Send \"Stops - page 1 (stores cursor)\" first.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const next = json.meta ? json.meta.nextCursor : null;",
                  "pm.environment.set('cursor', next || '');",
                  "console.log(next ? 'nextCursor refreshed (' + next.length + ' chars)' : 'Reached last page - cursor cleared');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/stops?limit=5&cursor={{cursor}}",
              "host": ["{{api_url}}"],
              "path": ["stops"],
              "query": [
                { "key": "limit", "value": "5" },
                { "key": "cursor", "value": "{{cursor}}" }
              ]
            },
            "description": "Follow-up page using the cursor saved by the first-page request."
          },
          "response": []
        }
      ]
    },
