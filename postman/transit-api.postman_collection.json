    {
      "name": "Bookings",
      "description": "Full booking lifecycle: create, read, update, delete.",
      "item": [
        {
          "name": "List Bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has data array', () => pm.expect(json.data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/bookings?limit={{default_limit}}",
              "host": ["{{api_url}}"],
              "path": ["bookings"],
              "query": [{ "key": "limit", "value": "{{default_limit}}" }]
            },
            "description": "Paginated booking list with joined route/stop names. Supports filters (status, routeId, travelDate, minFare, maxFare, passenger)."
          },
          "response": []
        },
        {
          "name": "List Bookings (by travel_date + status)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/bookings?travelDate={{travel_date}}&status={{booking_status_filter}}&limit={{default_limit}}",
              "host": ["{{api_url}}"],
              "path": ["bookings"],
              "query": [
                { "key": "travelDate", "value": "{{travel_date}}" },
                { "key": "status", "value": "{{booking_status_filter}}" },
                { "key": "limit", "value": "{{default_limit}}" }
              ]
            },
            "description": "Bookings on {{travel_date}} with status {{booking_status_filter}}."
          },
          "response": []
        },
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const api = pm.environment.get('api_url');",
                  "const routesResp = await pm.sendRequest({ url: api + '/routes?limit=50', method: 'GET' });",
                  "const routes = routesResp.json().data || [];",
                  "if (routes.length === 0) throw new Error('No routes found to create a booking');",
                  "const route = routes[Math.floor(Math.random() * routes.length)];",
                  "const stopsResp = await pm.sendRequest({ url: api + '/routes/' + route.id + '/stops?limit=20', method: 'GET' });",
                  "const stops = stopsResp.json().data || [];",
                  "if (stops.length < 2) throw new Error('Route ' + route.id + ' has fewer than two stops');",
                  "pm.environment.set('route_id', route.id);",
                  "pm.environment.set('from_stop_id', stops[0].id);",
                  "pm.environment.set('to_stop_id', stops[stops.length - 1].id);",
                  "console.log('route_id = ' + route.id + ', from = ' + stops[0].id + ', to = ' + stops[stops.length - 1].id);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('booking_id', json.data.id);",
                  "pm.environment.set('booking_reference', json.data.reference);",
                  "pm.test('Fare is computed', () => pm.expect(json.data.fare).to.be.a('number'));",
                  "console.log('Created ' + json.data.reference + ' fare=' + json.data.fare + ' seats=' + json.data.seats);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passenger_name\": \"{{passenger_name}}\",\n  \"email\": \"{{passenger_email}}\",\n  \"route_id\": \"{{route_id}}\",\n  \"from_stop_id\": \"{{from_stop_id}}\",\n  \"to_stop_id\": \"{{to_stop_id}}\",\n  \"seats\": 2,\n  \"status\": \"{{booking_status}}\",\n  \"travel_date\": \"{{travel_date}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_url}}/bookings",
              "host": ["{{api_url}}"],
              "path": ["bookings"]
            },
            "description": "Pre-request script picks a random route and two different stops on it, then the body is rendered with those ids. The test script stores the new booking id/reference."
          },
          "response": []
        },
        {
          "name": "Get Booking by ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('booking_id')) {",
                  "  const resp = await pm.sendRequest({",
                  "    url: pm.environment.get('api_url') + '/bookings?limit=1&status=confirmed',",
                  "    method: 'GET',",
                  "    header: { accept: 'application/json' }",
                  "  });",
                  "  const bookings = resp.json().data || [];",
                  "  if (bookings.length === 0) throw new Error('No booking available (bookings list is empty)');",
                  "  pm.environment.set('booking_id', bookings[0].id);",
                  "  console.log('booking_id = ' + bookings[0].id);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/bookings/{{booking_id}}",
              "host": ["{{api_url}}"],
              "path": ["bookings", "{{booking_id}}"]
            },
            "description": "Uses {{booking_id}} if present, otherwise the pre-request script fetches one."
          },
          "response": []
        },
        {
          "name": "Update Booking (PATCH)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('booking_id')) {",
                  "  const resp = await pm.sendRequest({",
                  "    url: pm.environment.get('api_url') + '/bookings?limit=1&status=confirmed',",
                  "    method: 'GET',",
                  "    header: { accept: 'application/json' }",
                  "  });",
                  "  const bookings = resp.json().data || [];",
                  "  if (bookings.length === 0) throw new Error('No booking available (bookings list is empty)');",
                  "  pm.environment.set('booking_id', bookings[0].id);",
                  "  console.log('booking_id = ' + bookings[0].id);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Seats updated', () => pm.expect(json.data.seats).to.equal(3));",
                  "console.log('Updated: seats=' + json.data.seats + ' fare=' + json.data.fare + ' status=' + json.data.status);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seats\": 3,\n  \"status\": \"pending\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_url}}/bookings/{{booking_id}}",
              "host": ["{{api_url}}"],
              "path": ["bookings", "{{booking_id}}"]
            },
            "description": "Updates seats (fare is recomputed server-side) and sets status to pending."
          },
          "response": []
        },
        {
          "name": "Delete Booking (DELETE)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('booking_id')) {",
                  "  const resp = await pm.sendRequest({",
                  "    url: pm.environment.get('api_url') + '/bookings?limit=1&status=confirmed',",
                  "    method: 'GET',",
                  "    header: { accept: 'application/json' }",
                  "  });",
                  "  const bookings = resp.json().data || [];",
                  "  if (bookings.length === 0) throw new Error('No booking available (bookings list is empty)');",
                  "  pm.environment.set('booking_id', bookings[0].id);",
                  "  console.log('booking_id = ' + bookings[0].id);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('booking_id', '');",
                  "console.log('Booking deleted, booking_id cleared');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{api_url}}/bookings/{{booking_id}}",
              "host": ["{{api_url}}"],
              "path": ["bookings", "{{booking_id}}"]
            },
            "description": "Deletes and clears {{booking_id}} on success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error scenarios",
      "description": "Requests that intentionally exercise the API error taxonomy (400/404/405/422/429).",
      "item": [
        {
          "name": "limit=0 -> 400 INVALID_QUERY",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/stops?limit=0",
              "host": ["{{api_url}}"],
              "path": ["stops"],
              "query": [{ "key": "limit", "value": "0" }]
            },
            "description": "Expect 400."
          },
          "response": []
        },
        {
          "name": "active=maybe -> 400 INVALID_FILTER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/routes?active=maybe",
              "host": ["{{api_url}}"],
              "path": ["routes"],
              "query": [{ "key": "active", "value": "maybe" }]
            },
            "description": "Expect 400."
          },
          "response": []
        },
        {
          "name": "malformed booking id -> 400 INVALID_ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/bookings/bkg_xyz",
              "host": ["{{api_url}}"],
              "path": ["bookings", "bkg_xyz"]
            },
            "description": "Expect 400."
          },
          "response": []
        },
        {
          "name": "unknown route -> 404 NOT_FOUND",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/routes/rte_0000000000000000",
              "host": ["{{api_url}}"],
              "path": ["routes", "rte_0000000000000000"]
            },
            "description": "Well-formed but nonexistent id. Expect 404."
          },
          "response": []
        },
        {
          "name": "create stop (duplicate name+city) -> 409 CONFLICT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resp = await pm.sendRequest({",
                  "  url: pm.environment.get('api_url') + '/stops?limit=50',",
                  "  method: 'GET',",
                  "  header: { accept: 'application/json' }",
                  "});",
                  "const stops = resp.json().data || [];",
                  "if (stops.length === 0) throw new Error('No stops found - is the DB seeded?');",
                  "const stop = stops[Math.floor(Math.random() * stops.length)];",
                  "pm.environment.set('stop_name', stop.name);",
                  "pm.environment.set('stop_city', stop.city);",
                  "console.log('Duplicating stop ' + stop.name + ' (' + stop.city + ')');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{stop_name}}\",\n  \"city\": \"{{stop_city}}\",\n  \"latitude\": 0,\n  \"longitude\": 0,\n  \"stop_type\": \"bus\",\n  \"zone\": \"1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_url}}/stops",
              "host": ["{{api_url}}"],
              "path": ["stops"]
            },
            "description": "Creates a stop that already exists (unique name+city). Expect 409 CONFLICT."
          },
          "response": []
        },
        {
          "name": "create booking (bad payload) -> 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passenger_name\": \"Nope\",\n  \"email\": \"not-an-email\",\n  \"route_id\": \"rte_0000000000000000\",\n  \"from_stop_id\": \"stp_0000000000000000\",\n  \"to_stop_id\": \"stp_0000000000000001\",\n  \"seats\": 99,\n  \"status\": \"unknown\",\n  \"travel_date\": \"2026-13-40\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_url}}/bookings",
              "host": ["{{api_url}}"],
              "path": ["bookings"]
            },
            "description": "Several validation failures at once. Expect 422 VALIDATION_ERROR."
          },
          "response": []
        },
        {
          "name": "DELETE /stops/:id -> 405",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resp = await pm.sendRequest({",
                  "  url: pm.environment.get('api_url') + '/stops?limit=50',",
                  "  method: 'GET',",
                  "  header: { accept: 'application/json' }",
                  "});",
                  "const stops = resp.json().data || [];",
                  "if (stops.length === 0) throw new Error('No stops found - is the DB seeded?');",
                  "const stop = stops[Math.floor(Math.random() * stops.length)];",
                  "pm.environment.set('stop_id', stop.id);",
                  "console.log('stop_id = ' + stop.id);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 405', () => pm.response.to.have.status(405));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{api_url}}/stops/{{stop_id}}",
              "host": ["{{api_url}}"],
              "path": ["stops", "{{stop_id}}"]
            },
            "description": "Expect 405 with an Allow: GET header."
          },
          "response": []
        }
      ]
    }
  ]
}
