                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time is reasonable', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Liveness probe. Expect 200."
          },
          "response": []
        }
      ]
