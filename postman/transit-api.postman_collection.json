                  "const stops = json.data || [];",
                  "if (stops.length >= 2) {",
                  "  const from = stops[0].id;",
                  "  const to = stops[stops.length - 1].id;",
                  "  pm.environment.set('from_stop_id', from);",
                  "  pm.environment.set('to_stop_id', to);",
                  "  console.log('from_stop_id = ' + from + ', to_stop_id = ' + to);",
                  "} else {",
                  "  console.log('Route has fewer than 2 stops - booking vars not updated');",
