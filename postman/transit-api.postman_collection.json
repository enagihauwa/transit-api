        {
          "name": "Create Vehicle",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = Date.now().toString(36) + Math.random().toString(36).slice(2, 5);",
                  "pm.environment.set('vehicle_registration', 'REF-' + token.toUpperCase());",
                  "const hasRoute = pm.environment.get('route_id');",
                  "if (hasRoute) {",
                  "  pm.request.body.raw = JSON.stringify({",
                  "    registration: pm.variables.replaceIn('{{vehicle_registration}}'),",
                  "    make: 'ReferenceBus',",
                  "    model: 'RV-9000',",
                  "    year: Number(pm.environment.get('vehicle_year')),",
                  "    capacity: Number(pm.environment.get('vehicle_capacity')),",
                  "    vehicle_type: pm.environment.get('vehicle_type'),",
                  "    status: pm.environment.get('vehicle_status'),",
                  "    route_id: hasRoute",
                  "  }, null, 2);",
                  "} else {",
                  "  pm.request.body.raw = JSON.stringify({",
                  "    registration: pm.variables.replaceIn('{{vehicle_registration}}'),",
                  "    make: 'ReferenceBus',",
                  "    model: 'RV-9000',",
                  "    year: Number(pm.environment.get('vehicle_year')),",
                  "    capacity: Number(pm.environment.get('vehicle_capacity')),",
                  "    vehicle_type: pm.environment.get('vehicle_type'),",
                  "    status: pm.environment.get('vehicle_status')",
                  "  }, null, 2);",
                  "}",
                  "console.log('vehicle_registration = ' + pm.environment.get('vehicle_registration') + ' route_id = ' + (hasRoute || 'none'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('vehicle_id', json.data.id);",
                  "pm.test('Has id', () => pm.expect(json.data.id).to.match(/^veh_/));",
                  "console.log('Created vehicle ' + json.data.registration + ' id=' + json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
