# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/transit
# Managed Postgres providers (Railway, Neon, Render, Supabase) require TLS.
DATABASE_SSL=false
# Set when running behind a reverse proxy / tunnel so rate limiting keys on
# the real client IP instead of the proxy's.
TRUST_PROXY=false

# Pagination
DEFAULT_LIMIT=20
MAX_LIMIT=100

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Seed volumes
SEED_VALUE=20241809
SEED_STOPS=300
SEED_ROUTES=300
SEED_VEHICLES=300
SEED_BOOKINGS=800
# Set true to stop the server auto-seeding an empty database on boot.
SEED_SKIP_AT_BOOT=false
